        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Meridian",
      "pivotStyles": []
    },
    "362bcb8e-9a02-4401-a0c4-7769ab6b1454": {
      "start": 12419,
      "end": 12563,
      "txt": "تقول أنهم .. أختفوا ؟ ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "So these guys just disappear?",
      "pivotStyles": []
    },
    "38886bb9-50c5-479f-9c97-d98742100121": {
      "start": 32980,
      "end": 33022,
      "txt": "\"جايك\".",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Jake.",
      "pivotStyles": []
    },
    "3ebf1bbd-12c4-4e73-8479-33b7566f4ed6": {
      "start": 1858,
      "end": 2127,
      "txt": "أجل , بإمتداد ذلك الطريق ، على شاطيء \"الماتادور\" ، أتعرفه ؟ ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": " Yeah, on that stretch of road right above El Matador. You know it?",
      "pivotStyles": []
    },
    "3f670198-cefc-4f3d-8642-7974e105231d": {
      "start": 6022,
      "end": 6060,
      "txt": "شاهداً؟",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "A witness?",
      "pivotStyles": []
    },
    "3fee7765-3156-4cc7-ae3e-b5f6faad2c54": {
      "start": 31750,
      "end": 31826,
      "txt": "الشرطة لا تتحركوا  .  ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "LAPD: Los Angeles Police Department"
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "LAPD, put your hands in the air!",
      "pivotStyles": []
    },
    "404e0172-8208-4f5c-bf65-c64d25e3cbbb": {
      "start": 19161,
      "end": 19240,
      "txt": "فقط. سيارته . ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "No. Just his car.",
      "pivotStyles": []
    },
    "4326a403-9b8a-4017-b306-227757d0f431": {
      "start": 5174,
      "end": 5211,
      "txt": "انتحار؟",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Suicide?",
      "pivotStyles": []
    },
    "44c7bbbf-3d4e-4133-8562-fcb72d051e75": {
      "start": 7237,
      "end": 8162,
      "txt": "أخذ كلبه في جولة على المنحدرات فوق \"الماتادور\". ونظر  إلى الصخرة الضخمة المنفصلة عن اليابسة حيث يلتقي المحيط بالشاطئ. \nقال إنها ، كمخلوق ، بحري أسطوري أتعرفها؟",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "He said he was out there walking his dog along the bluffs above El Matador, right? And he looks down at the beach at that huge rock, you know, the one that's separated from the mainland, right where the ocean meets the shore. His words, looks like a, like a \"mythic sea creature.\" You know that one?",
      "pivotStyles": []
    },
    "4a74f69d-38cd-44de-ab09-14e59257b7f5": {
      "start": 1614,
      "end": 1768,
      "txt": "تقول أنهم .. أختفوا ؟ ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "So these guys just... disappear?",
      "pivotStyles": []
    },
    "4a8a7172-1c67-4c5f-9aa8-28f949fd4968": {
      "start": 5528,
      "end": 5700,
      "txt": "أولًا  لا توجد جثث، وأيضًا...",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Well, for one thing, there's no bodies and...",
      "pivotStyles": []
    },
    "4c0c7597-98f2-4cf5-9d45-9a31863eb117": {
      "start": 5784,
      "end": 5966,
      "txt": "هناك شاهداً يوم ، اختفاء الرجل الأخير. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Somebody was out there the day the last guy disappeared.",
      "pivotStyles": []
    },
    "544534b1-42e5-4617-abf6-176024efae01": {
      "start": 5255,
      "end": 5327,
      "txt": "كما حدث من قبل",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "It's been known to happen out there.",
      "pivotStyles": []
    },
    "5692fd57-0257-4aea-a050-7a4a2a028f24": {
      "start": 13066,
      "end": 13796,
      "txt": "أخذ كلبه في جولة على المنحدرات فوق \"الماتادور\". \n  رأى رجلًا ،  فوق تلك الصخرة. كان يبحث بأنحاء الصخرة ،  عن شيء أو شخص ما. \n",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "He said that he was up there walking his dog along those bluffs above El Matador. And there's a guy who's on top of that rock. And he's just like looking all over the rock as if he's looking for someone or something.",
      "pivotStyles": []
    },
    "5bff15a7-e1de-4e25-90ed-d9864dc5d016": {
      "start": 2434,
      "end": 2678,
      "txt": "\"ميكي كوهين\" إعتاد الذهاب إلى هناك ، لكي يودع شركائه",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.ForeignDialog"
        ],
        "text": "bon voyage - French way to say goodbye "
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Well, Mickey Cohen used to take his associates out there. Bid them a bon voyage. ",
      "pivotStyles": [
        {
          "to": 80,
          "from": 69,
          "type": "italic"
        }
      ]
    },
    "5f24849e-e92e-4c9f-af59-aac423fc1760": {
      "start": 20311,
      "end": 20383,
      "txt": " تسمعني أيها النقيب؟",
      "characterId": "93fbd60e-8d5d-44e4-a2f6-3aba98c2902a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Are you still there, Captain?",
      "pivotStyles": []
    },
    "6b60a09d-3bef-4b20-be17-5539bb38c325": {
      "start": 7115,
      "end": 7235,
      "txt": "صوت",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
