        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "EARL CARROLL THEATRE",
      "pivotStyles": []
    },
    "20b6ed71-2392-465d-bc06-65dafb4c656b": {
      "start": 33631,
      "end": 33689,
      "txt": "يا إلهي.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Oh my God.",
      "pivotStyles": []
    },
    "25dfcc14-3364-4d1f-b917-96b26b0911f3": {
      "start": 12624,
      "end": 12868,
      "txt": "ليس هذه المرّة. \nهناك شاهداً يوم  اختفاء الرجل الأخير. \n",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Nah, not this time. Somebody was out there the day the last guy disappeared.",
      "pivotStyles": []
    },
    "29a5f0f8-5ebb-4c39-abeb-9b4254f96b7f": {
      "start": 3329,
      "end": 3374,
      "txt": "أيه صلات ؟ ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Any connection? ",
      "pivotStyles": []
    },
    "2a71e6c5-3bd7-4f1b-a513-2db5ae48241b": {
      "start": 2305,
      "end": 2325,
      "txt": "أجل.",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah.",
      "pivotStyles": []
    },
    "2b1cc03d-c5fc-47af-9352-0348bd2c7758": {
      "start": 10795,
      "end": 11473,
      "txt": "رآها، كانت جميلة. لكن كأنها من زمن أو مكان آخر. \nولاحظ أن الطقس كان يزداد سوءًا. \nفقرر المغادرة بسرعة.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Hightail it: leave quickly."
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "He sees her, she's beautiful. But like she's from some other time, some other place. He looks back at the weather, because it's getting worse and worse, and decides to hightail it out of there.",
      "pivotStyles": []
    },
    "2ed0ad3e-6e01-42b0-af63-d9990a8e9821": {
      "start": 9986,
      "end": 10681,
      "txt": "ونظر للصخرة ، اختفى الرجل. \nلكن وجد امرأة. بفستان أبيض. وصف بشرتها ، كالمرمر . وقال إنها كانت تحدّق به. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "When he looks back at the rock, the guy's gone. But there's a woman there. She's in a white dress. Alabaster skin, his words, and he says she's staring right up at him.",
      "pivotStyles": []
    },
    "31bc9fd2-5295-499d-b260-8bf3d278f1dd": {
      "start": 1406,
      "end": 1781,
      "txt": ".",
      "characterId": "00000000-0000-0000-0000-000000000000",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.MainTitle"
        ],
