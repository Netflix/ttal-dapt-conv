      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, a witness.",
      "pivotStyles": []
    },
    "834b7b0f-1d64-41f1-825a-2cbb93bb4c54": {
      "start": 4275,
      "end": 4501,
      "txt": "[صوت] \nأذن أظن عليك عدم الذهاب إلى هناك ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Oh. Well, in that case, maybe you don't want to go out there boss.",
      "pivotStyles": []
    },
    "860cbea6-b2df-4402-848d-6ddb9c57b15e": {
      "start": 12024,
      "end": 12209,
      "txt": "أريدك، أن تذهب وتجد تلك المرأة. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Now, I need you to go up there and find that woman.",
      "pivotStyles": []
    },
    "887e521e-51c6-4458-905d-39e9e583b18e": {
      "start": 105,
      "end": 310,
      "txt": "\"(لوس أنجلوس) 1947.\"",
      "characterId": "00000000-0000-0000-0000-000000000000",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.GraphicsInserts"
        ],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
