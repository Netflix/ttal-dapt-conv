      "pivotStyles": []
    },
    "0b26ecf9-1318-4bf7-a0af-bbb3769ee412": {
      "start": 6677,
      "end": 7122,
      "txt": "تحرّيت ووجدته بأعلى مراتب الكشّافة.\n، لا أعرف، ماذا أصدّق الان. \nلا أريد تصديقه. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Eagle Scout: Eagle Scout is the highest rank attainable in the Scouts BSA program by the Boy Scouts of America. With this he is implying he is probably a reputable/good person."
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "I had him checked out too. Guy's a goddamn Eagle Scout. So now, now I don't know what to believe. I know I don't want to believe him.",
      "pivotStyles": []
    },
    "0e03b28d-c3f7-465d-a766-5ddf62b86bc1": {
      "start": 6182,
      "end": 6264,
      "txt": "و لم لم تقل من البداية ؟",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Well, why didn't you say that in the first place?",
      "pivotStyles": []
    },
    "1548c6d9-64f1-4dc6-8914-5467e91aa16f": {
      "start": 939,
      "end": 1052,
      "txt": ".",
      "characterId": "00000000-0000-0000-0000-000000000000",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.PrinciplePhotography"
        ],
        "text": ""
      },
      "styles": [],
