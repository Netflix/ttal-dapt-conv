      "type": ""
    },
    "727bc126-8525-47c1-b342-0ec5475db6be": {
      "start": 2185,
      "end": 2227,
      "txt": "عند الصخرة  ؟",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "With the big rock?",
      "pivotStyles": []
    },
    "76e633ab-e1e9-4d0a-8092-c465d43e4eda": {
      "start": 11910,
      "end": 11958,
      "txt": "والآن...",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": " So now...",
      "pivotStyles": []
    },
    "7ddd5ad4-852d-4b83-9232-b34fc38c203c": {
      "start": 4834,
      "end": 5157,
      "txt": "اسمع أنا أعرف ما حدث. \nذهبوا للصخرة، وبدؤوا رحلتهم بالسباحة إلى \"الصين\". ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, look, I know what happened, alright. They go out to the rock. They take that long, cold, slow swim to China.",
      "pivotStyles": []
    },
    "7fb12623-7c45-46d8-8067-51ba15038e44": {
      "start": 6108,
      "end": 6176,
      "txt": "أجل شاهداً.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, a witness.",
      "pivotStyles": []
    },
    "80a55598-fc2c-4d86-8f30-2f3eeeadd8da": {
      "start": 12943,
      "end": 13013,
      "txt": "ًأجل  شاهدا.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
