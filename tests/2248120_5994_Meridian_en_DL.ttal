    "0b26ecf9-1318-4bf7-a0af-bbb3769ee412": {
      "start": 6677,
      "end": 7122,
      "txt": "I had him checked out too. Guy's a goddamn Eagle Scout. So now, now I don't know what to believe. I know I don't want to believe him.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Eagle Scout: Eagle Scout is the highest rank attainable in the Scouts BSA program by the Boy Scouts of America. With this he is implying he is probably a reputable/good person."
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
