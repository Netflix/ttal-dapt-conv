      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "d5ed8427-2985-43db-8774-a40f22b64367": {
      "start": 20488,
      "end": 20541,
      "txt": "Captain Foster?",
      "characterId": "93fbd60e-8d5d-44e4-a2f6-3aba98c2902a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
