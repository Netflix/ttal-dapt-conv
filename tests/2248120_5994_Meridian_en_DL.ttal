    "a993d17b-bd12-4530-b59b-716651a29989": {
      "start": 32412,
      "end": 32638,
      "txt": "[REACTION]",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
