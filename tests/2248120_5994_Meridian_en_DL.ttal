      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.ForeignDialog"
        ],
        "text": "bon voyage - French way to say goodbye "
      },
      "styles": [
        {
          "from": 69,
          "to": 80,
          "type": "italic"
        }
      ],
      "transcriptionRubies": {},
