    "5692fd57-0257-4aea-a050-7a4a2a028f24": {
      "start": 13066,
      "end": 13796,
      "txt": "He said that he was up there walking his dog along those bluffs above El Matador. And there's a guy who's on top of that rock. And he's just like looking all over the rock as if he's looking for someone or something.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
