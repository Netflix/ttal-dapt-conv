      },
      "rubies": {},
      "type": ""
    },
    "45483000-07f1-452a-a3d5-daaf379cff80": {
      "start": 14336,
      "end": 14557,
      "txt": "Una mujer con ojos azules aparece en el retrovisor.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
