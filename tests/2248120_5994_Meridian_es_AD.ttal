    "533307cd-60de-45e5-bacb-c2caf7ec9114": {
      "start": 19896,
      "end": 20184,
      "txt": "Cuelga el teléfono en la ventanilla del auto.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
