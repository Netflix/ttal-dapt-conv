        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "e5a86d99-690f-483a-9972-3e7ec720ada6": {
      "start": 27653,
      "end": 28182,
      "txt": "Mira a un lado y camina apuntando al frente. Los ojos azules del muñeco siguen el movimiento de Foster",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
