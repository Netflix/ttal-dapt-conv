    "91fcdcfd-1c18-4f7a-9797-1e4bb15a7e21": {
      "start": 22384,
      "end": 23153,
      "txt": "Luego, Foster camina junto al mar. Hay rocas grandes y pequeñas en la playa bañada por las olas. Foster camina despacio. Lleva un abrigo ligero,",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
