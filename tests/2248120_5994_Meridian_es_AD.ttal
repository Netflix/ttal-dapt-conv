    "b738b8e0-a5cc-4c8a-9d1f-6a792c73102d": {
      "start": 20686,
      "end": 22354,
      "txt": "Mira la gran roca separada de tierra firme. Imagen de Foster de frente en el risco observando la roca. Varios rayos iluminan el cielo. Mira atrás. Vuelve a mirar la roca. Alza la mirada. Mira la roca una vez más. Tiene dos cavidades en la parte inferior. Foster camina. Las nubes oscuras se mueven en el cielo iluminadas por los relámpagos.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "b7b93028-33f4-4b09-a6ca-b8006545a5b7": {
      "start": 26734,
      "end": 27556,
      "txt": "Ilumina un muñeco de ventrílocuo sentado en un banco. Lleva un traje negro y un corbatín rojo. Foster saca una pistola y le apunta. Se acerca e ilumina al muñeco. ",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
