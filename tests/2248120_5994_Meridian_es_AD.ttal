    "4b796721-fa7d-461c-8230-d39e64ca02cb": {
      "start": 15543,
      "end": 16314,
      "txt": "No hay nadie en el asiento trasero. Él, observa a la mujer en el retrovisor. Los rayos iluminan el rostro de la mujer. Sóhlivan mira fijo el reflejo de la mujer en el espejo.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
