    },
    "ce3ca9a4-a4a7-45ab-9f92-65963f90d63e": {
      "start": 33051,
      "end": 33611,
      "txt": "Sóhlivan lleva el mismo traje. Mira inexpresivo al frente. Foster baja la pistola. Se acerca con la linterna alzada.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
