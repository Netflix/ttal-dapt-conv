    "90ca267c-c2bb-40da-8565-b6e4d4821705": {
      "start": 23211,
      "end": 23417,
      "txt": "Una lluvia de relámpagos cubre el cielo.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
