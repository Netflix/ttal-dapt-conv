    "3e3a627c-78cf-453e-873f-79c8766ec2bc": {
      "start": 28209,
      "end": 29252,
      "txt": "Foster sigue caminando. Se detiene. Mira un reloj analógico sin agujas. La imagen se acerca al reloj cuyos números giran en el sentido de las agujas. Foster mira a un lado y camina.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
