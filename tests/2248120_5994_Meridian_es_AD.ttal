    "8d6f751c-8d15-4659-848d-a381987e1296": {
      "start": 29484,
      "end": 30627,
      "txt": "Entreabre la boca. Mira fijo al frente. Baja la pistola y la linterna. La luz exterior se cuela por un vitral de varios colores. Hay agua en el suelo. A un lado, una pantalla muestra a Foster de espalda observando la gran roca desde el borde del risco.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
