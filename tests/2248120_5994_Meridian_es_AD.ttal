    "358309dc-8966-4ebb-84bb-062bac5dcc8e": {
      "start": 60,
      "end": 935,
      "txt": "Es de día. Texto en pantalla: Los Ángeles, 1947.  Tranvías y autos circulan por Hollywood Blvd. En un letrero sobre un edificio se lee: The Broadway Holywood. ",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
