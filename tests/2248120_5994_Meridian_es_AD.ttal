      "start": 34680,
      "end": 34805,
      "txt": "La pantalla se oscurece.",
      "characterId": "2a34a2b5-2df2-4fee-a82c-fc6cc33770dc",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
