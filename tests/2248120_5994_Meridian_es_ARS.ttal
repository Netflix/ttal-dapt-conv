    "0a60d849-3d06-4067-b9d5-efd09b4cabf7": {
      "start": 12919,
      "end": 12933,
      "txt": "(reac)",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
