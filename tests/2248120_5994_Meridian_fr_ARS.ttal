      "type": ""
    },
    "10d8ffdc-e30d-4594-9ade-baaee4e81417": {
      "start": 8487,
      "end": 8748,
      "txt": "Et il se dit, comment il a fait pour monter jusque là-haut ? Faut qu'il soit équipé, faut être alpiniste. ",
      "characterId": "1270c10a-6fb3-4881-9197-d4ae81b04b3b",
      "segments": [],
      "aux": {},
