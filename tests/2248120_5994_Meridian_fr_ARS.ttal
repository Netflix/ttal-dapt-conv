      "start": 1858,
      "end": 2127,
      "txt": "Oui, le nom de cette portion de route qui surplombe El Matador. Tu vois où ?",
      "characterId": "1270c10a-6fb3-4881-9197-d4ae81b04b3b",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
