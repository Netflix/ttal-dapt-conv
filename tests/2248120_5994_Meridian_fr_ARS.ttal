    "0f9687b7-30e8-4b66-86e7-07ee5025d206": {
      "start": 2719,
      "end": 3252,
      "txt": "La mafia ? Non pas ce coup-ci. C'est des types ordinaires. Un instit', un vendeur de contrats d'assurance et un retraité. ",
      "characterId": "1270c10a-6fb3-4881-9197-d4ae81b04b3b",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
