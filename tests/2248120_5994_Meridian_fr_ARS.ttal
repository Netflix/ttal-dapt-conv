      "start": 4597,
      "end": 4807,
      "txt": "Tu joues les comiques ? Dans ce cas-là, c'est toi qui ferait mieux de ne pas y aller.",
      "characterId": "1270c10a-6fb3-4881-9197-d4ae81b04b3b",
      "segments": [],
