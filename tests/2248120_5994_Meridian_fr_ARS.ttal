    "a96d3767-f49e-4e43-9f5b-3f352f11da21": {
      "start": 3417,
      "end": 4063,
      "txt": "Hum hum. J'ai épluché leur pédigrée. Des casiers judiciaires vierges, étrangers à toute organisation criminelle. Il y en a un qui a été arrêté pour conduite en état d'ivresse il y a longtemps. ",
      "characterId": "1270c10a-6fb3-4881-9197-d4ae81b04b3b",
