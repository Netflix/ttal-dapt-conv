        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Because I thought the guy was nuts. What he said...",
      "pivotStyles": []
    },
