    },
    "27387844-a4ac-4de7-9900-fb39526828a1": {
      "start": 2605,
      "end": 2678,
      "txt": "행운도 빌어주면서…",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
