    },
    "0b26ecf9-1318-4bf7-a0af-bbb3769ee412": {
      "start": 6677,
      "end": 6858,
      "txt": "신원을 확인해 보니, 빌어먹을 정찰꾼이더군. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Eagle Scout: Eagle Scout is the highest rank attainable in the Scouts BSA program by the Boy Scouts of America. With this he is implying he is probably a reputable/good person."
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "I had him checked out too. Guy's a goddamn Eagle Scout. So now, now I don't know what to believe. I know I don't want to believe him.",
      "pivotStyles": []
    },
    "0e03b28d-c3f7-465d-a766-5ddf62b86bc1": {
      "start": 6182,
      "end": 6264,
      "txt": "왜 말씀 안 하셨습니까?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Well, why didn't you say that in the first place?",
      "pivotStyles": []
    },
    "0e53129f-ee67-4f9e-a892-4b1a7bc82275": {
      "start": 7629,
      "end": 7851,
      "txt": "그 왜 땅에서 좀 떨어져 있는 해변의 바위 있잖아.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "0ff7c152-4a6c-4819-b277-200c9ba585ba": {
      "start": 8319,
      "end": 8445,
      "txt": "바위 위에 누가 있더라는 거야.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
