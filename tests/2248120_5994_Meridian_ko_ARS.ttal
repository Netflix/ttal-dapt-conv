    },
    "1b9814fe-f9d2-4174-ab8e-904a3fe2ce92": {
      "start": 3506,
      "end": 3578,
      "txt": "내가 다 뒤져봤는데",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
