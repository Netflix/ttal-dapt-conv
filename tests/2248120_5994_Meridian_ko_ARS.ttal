      "pivotText": "Yeah, a witness.",
      "pivotStyles": []
    },
    "834b7b0f-1d64-41f1-825a-2cbb93bb4c54": {
      "start": 4275,
      "end": 4324,
      "txt": "아… ",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Oh. Well, in that case, maybe you don't want to go out there boss.",
      "pivotStyles": []
    },
    "860cbea6-b2df-4402-848d-6ddb9c57b15e": {
      "start": 12024,
      "end": 12209,
      "txt": "자네가/ 거기로 가서 그 여자를 찾아봐.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Now, I need you to go up there and find that woman.",
      "pivotStyles": []
    },
    "887e521e-51c6-4458-905d-39e9e583b18e": {
      "start": 105,
      "end": 310,
      "txt": "1947년 로스앤젤레스",
      "characterId": "e1bfc9e7-d494-4d6b-8ca6-55dffa3f981e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
