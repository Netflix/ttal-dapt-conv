        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "And now you believe him?",
      "pivotStyles": []
    },
    "ca9602c3-c255-46c9-b177-afeda9410951": {
      "start": 4171,
      "end": 4251,
      "txt": "셋 다 이혼했더군.",
