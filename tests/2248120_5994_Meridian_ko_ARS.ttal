        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "fn",
      "rgn": "top",
      "pivotText": "Los Angeles 1947",
      "pivotStyles": []
    },
    "88e80216-d625-40df-b873-356fcb08fbab": {
      "start": 5367,
      "end": 5446,
      "txt": "아… 이번엔 아니야. (깊은 들숨)",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Nah, not this time. ",
      "pivotStyles": []
    },
    "8fa49596-b51f-4967-852e-8ea8e41de917": {
      "start": 8487,
      "end": 8617,
      "txt": "대체 어떻게 올라간 건지 몰라도",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "And he's thinking to himself, \"How the hell do you get up there? You got to be a goddamn mountain climber.\" But more importantly, he says the guy's acting really funny. He's looking all over that rock, like he's looking for something or someone.",
      "pivotStyles": []
    },
    "948a03d7-eeef-4a44-be16-1f37e93a6f63": {
      "start": 20622,
      "end": 20701,
      "txt": "(f)(phone) 경감님, 응답하세요!/////",
      "characterId": "93fbd60e-8d5d-44e4-a2f6-3aba98c2902a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Captain, please come in!",
      "pivotStyles": []
    },
    "953e2e70-db60-44ee-b0f7-b892b0155a43": {
      "start": 19840,
      "end": 19888,
      "txt": "잠시만 있게.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": " Hang on a minute.",
      "pivotStyles": []
    },
    "979da638-fd44-44aa-8c93-3953dc890df2": {
      "start": 6859,
      "end": 7018,
      "txt": "그래서 이젠… 뭘 믿어야 할지 모르겠어.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "983fad40-c361-473d-8d6a-65575b2f6f9a": {
      "start": 31954,
      "end": 32032,
      "txt": "어서 손 들어",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Put your hands up now.",
      "pivotStyles": []
    },
    "9918014b-b15e-48b8-85a4-d7e31d19146a": {
      "start": 9212,
      "end": 9477,
      "txt": "근데 그 순간에 갑자기 주변이 깜깜하게 어두워졌대. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "At that very moment, he says it got really, really dark really fast and bombs start going off in the air. Thunder and lightning, weather like he'd never seen before, coming from he didn't know where.",
      "pivotStyles": []
    },
    "9b33944d-f42d-444a-913f-80f1fee7d43b": {
      "start": 14511,
      "end": 14614,
      "txt": "다시 그 바위를 보니",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "9d13f35b-6634-4f44-9a29-5893f72366b3": {
      "start": 11658,
      "end": 11799,
      "txt": "그게 그 목격자의 얘기야. 그게 전부였어./  ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": " And that was it. That was his story, right?",
      "pivotStyles": []
    },
    "9d5331ae-6514-4eb0-9d91-9b7746d8aaff": {
      "start": 9478,
      "end": 9735,
      "txt": "순식간에 깜깜해지더니 난데없이 폭탄이 터지는 것처럼  ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "9f669ea4-ec59-40f1-a03d-92bf22bbbffa": {
      "start": 15281,
      "end": 15422,
      "txt": "뭘 믿어야 할지 모르겠어. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
