    },
    "1c9789a5-7c5f-4b7f-9a1a-76e8bc921262": {
      "start": 13542,
      "end": 13796,
      "txt": "사람을 찾는지 뭘 찾는지, 바위를 샅샅이 살펴보더래./",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
