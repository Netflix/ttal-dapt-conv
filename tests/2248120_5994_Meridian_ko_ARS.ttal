    "dfede135-d444-4285-a897-d9cfa5fb5489": {
      "start": 19318,
      "end": 19474,
      "txt": "사람 보내기 전에 내가 일단 좀 둘러보고.../ ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
