      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "4a74f69d-38cd-44de-ab09-14e59257b7f5": {
      "start": 1614,
      "end": 1768,
      "txt": "그 남자들이 그냥… 사라졌다고요?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "So these guys just... disappear?",
      "pivotStyles": []
    },
    "4a8a7172-1c67-4c5f-9aa8-28f949fd4968": {
      "start": 5528,
      "end": 5700,
      "txt": "(날숨으로) 일단 시체가 없잖아. 그리고… (머뭇거리는 호)",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Well, for one thing, there's no bodies and...",
      "pivotStyles": []
    },
    "4c0c7597-98f2-4cf5-9d45-9a31863eb117": {
      "start": 5784,
      "end": 5966,
      "txt": "세 번째 남자가 사라진 날, 거기 누군가 있었거든.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Somebody was out there the day the last guy disappeared.",
      "pivotStyles": []
    },
    "4cb2eef7-3671-41ab-b12c-014b99875261": {
      "start": 2766,
      "end": 2890,
      "txt": "아니야, 이번엔 달라.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
