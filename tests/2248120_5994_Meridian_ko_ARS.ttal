    },
    "25dfcc14-3364-4d1f-b917-96b26b0911f3": {
      "start": 12624,
      "end": 12729,
      "txt": "(vo) (f) 아… 이번엔 아니야. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "TC 0129, TC 0136 반복"
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Nah, not this time. Somebody was out there the day the last guy disappeared.",
      "pivotStyles": []
    },
    "26485b4f-72d7-4afe-9dec-a41d38e27094": {
      "start": 8618,
      "end": 8736,
      "txt": "무슨 전문 산악인인가 싶었대.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
