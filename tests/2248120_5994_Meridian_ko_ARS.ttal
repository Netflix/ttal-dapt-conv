    "dba711b4-4e1c-49e2-8c3a-ebab70e1fecb": {
      "start": 6306,
      "end": 6478,
      "txt": "그자가 말한 게 다 헛소리라고 생각했거든.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Nuts: crazy."
