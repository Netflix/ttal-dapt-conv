        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "a68d66cc-0a2c-406b-9181-7ef95586192c": {
      "start": 20107,
      "end": 20225,
      "txt": "(f)(phone) 포스터 경감님, 응답하세요. ",
      "characterId": "93fbd60e-8d5d-44e4-a2f6-3aba98c2902a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Captain Foster, come in please.",
      "pivotStyles": []
    },
    "a6a95b2f-ed1f-4a8c-bf9e-f39269c058d0": {
      "start": 5491,
      "end": 5518,
      "txt": "(겹) 어째서요?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "What do you mean?",
      "pivotStyles": []
    },
    "a887b864-6fee-4112-b727-87be8d3069b9": {
      "start": 8882,
      "end": 9005,
      "txt": "사람을 찾는지 뭘 찾는지 ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "a8c08113-090f-4add-a8e0-1dcf8068c737": {
      "start": 8162,
      "end": 8182,
      "txt": "(말끝 겹) 네.",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah.",
      "pivotStyles": []
    },
    "a993d17b-bd12-4530-b59b-716651a29989": {
      "start": 32412,
      "end": 32638,
      "txt": "(겁먹은 호)",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "[REACTION]",
      "pivotStyles": []
    },
    "a9ea1cbc-72d9-4ccd-9c70-5588b9961095": {
      "start": 13965,
      "end": 14190,
      "txt": "(vo) (f) 근데 그 순간에 갑자기 주변이 깜깜하게 어두워졌대./ ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "TC 0233~0258,  0151 대사 편집, 반복"
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Then, it gets dark all of a sudden. Really fast. Like thunder and lightning from everywhere, all this weather. When he looks back at the rock... the guys gone, but there's a woman there in a long white dress with Alabaster skin. And she staring right up at him, not moving. I don't know what to believe. I know I sure don't want to believe him.",
      "pivotStyles": []
    },
    "ad8481d9-622d-4e08-9ec9-a5a925b25614": {
      "start": 3415,
      "end": 3453,
      "txt": "없어",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
