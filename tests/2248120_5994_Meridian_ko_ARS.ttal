      "pivotStyles": []
    },
    "3ebf1bbd-12c4-4e73-8479-33b7566f4ed6": {
      "start": 1858,
      "end": 2083,
      "txt": "그래, 엘마타도르 위에 있는 도로에서 말이야.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": " Yeah, on that stretch of road right above El Matador. You know it?",
      "pivotStyles": []
    },
    "3f670198-cefc-4f3d-8642-7974e105231d": {
      "start": 6022,
      "end": 6060,
      "txt": "목격자요?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
