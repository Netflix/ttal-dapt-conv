    "1f02706f-ea30-49e8-aa14-4710cd7539d8": {
      "start": 7999,
      "end": 8162,
      "txt": "신화에 나오는 바다 생물처럼 생겼다나?",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
