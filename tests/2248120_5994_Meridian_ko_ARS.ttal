        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, dispatch, this is Captain Foster. I'm out here at the El Matador location. There's no sign of Detective Sullivan.",
