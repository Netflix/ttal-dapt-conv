    "0a60d849-3d06-4067-b9d5-efd09b4cabf7": {
      "start": 12919,
      "end": 12931,
      "txt": "(vo) (f) (어이없다는 듯이 살짝 웃음)",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "TC 0141 반복"
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
