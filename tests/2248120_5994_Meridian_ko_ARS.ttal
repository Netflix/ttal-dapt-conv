    },
    "a25ea56f-20aa-4bc8-bee1-6a8f68ae63a0": {
      "start": 12878,
      "end": 12912,
      "txt": "(vo) (f) 목격자요?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "TC 0140 반복"
      },
      "styles": [],
      "transcriptionRubies": {},
