      "pivotStyles": []
    },
    "4366d728-233f-4b60-b06c-179a36f2dfbf": {
      "start": 28278,
      "end": 29380,
      "txt": "(걸어가면서 작게 호)(시계 보고 놀란 들숨)(겁먹은 호)//",
