      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "a674f6d0-0b5d-4a06-8947-d2bba9f0854c": {
      "start": 3626,
      "end": 3866,
      "txt": "아무 전과도 없고, 심지어 범죄 조직에 연루된 적도 없어",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
