      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "No. Just his car.",
      "pivotStyles": []
    },
    "4326a403-9b8a-4017-b306-227757d0f431": {
      "start": 5174,
      "end": 5211,
      "txt": "자살이라고?",
