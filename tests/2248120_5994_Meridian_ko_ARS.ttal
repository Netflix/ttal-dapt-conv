      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, look, I know what happened, alright. They go out to the rock. They take that long, cold, slow swim to China.",
      "pivotStyles": []
    },
    "7f08398b-da8f-470e-9e4c-d927a6ae247b": {
      "start": 7484,
      "end": 7628,
      "txt": "해변 쪽 큰 바위를 내려다봤다더군. ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
