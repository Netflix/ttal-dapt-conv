        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "A witness?",
      "pivotStyles": []
    },
    "3fee7765-3156-4cc7-ae3e-b5f6faad2c54": {
      "start": 31750,
      "end": 31826,
