        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "A witness?",
      "pivotStyles": []
    },
    "a45dd7e3-19f1-4564-9c73-1abd9253da50": {
      "start": 1817,
      "end": 1843,
      "txt": "(담배연기 내뿜는 호) ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "id": "a45dd7e3-19f1-4564-9c73-1abd9253da50"
    },
    "a5e17429-b440-411e-a1ea-2bc9d021a449": {
      "start": 3056,
      "end": 3158,
      "txt": "다른 한 명은 보험 판매원",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
