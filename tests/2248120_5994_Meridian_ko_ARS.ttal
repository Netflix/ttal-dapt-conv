    "039e31bd-15fa-4f41-8ef1-ad3754a7afee": {
      "start": 11593,
      "end": 11625,
      "txt": "(깊은 한숨)",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
