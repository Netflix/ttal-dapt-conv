    },
    "29a5f0f8-5ebb-4c39-abeb-9b4254f96b7f": {
      "start": 3329,
      "end": 3374,
      "txt": "연관성은요?",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Any connection? ",
      "pivotStyles": []
    },
    "2a71e6c5-3bd7-4f1b-a513-2db5ae48241b": {
      "start": 2305,
      "end": 2325,
      "txt": "네",
      "characterId": "9c514b7f-56ec-4a88-9a21-471104b8ad63",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah.",
      "pivotStyles": []
    },
    "2b1cc03d-c5fc-47af-9352-0348bd2c7758": {
      "start": 10795,
      "end": 10920,
      "txt": "여자가 정말 예쁘긴 했는데",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Hightail it: leave quickly."
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "He sees her, she's beautiful. But like she's from some other time, some other place. He looks back at the weather, because it's getting worse and worse, and decides to hightail it out of there.",
      "pivotStyles": []
    },
    "2ed0ad3e-6e01-42b0-af63-d9990a8e9821": {
      "start": 9986,
      "end": 10172,
      "txt": "다시 그 바위를 보니 남자는 사라졌고",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "When he looks back at the rock, the guy's gone. But there's a woman there. She's in a white dress. Alabaster skin, his words, and he says she's staring right up at him.",
      "pivotStyles": []
    },
    "30c53eca-8cfe-4c68-98f9-e5115dac2d44": {
      "start": 14228,
      "end": 14421,
      "txt": "천둥 번개가 치고 날씨가 변했다는 거야./ ",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
