        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Oh my God.",
      "pivotStyles": []
    },
    "24dbc86d-baa7-4354-86d1-8c5bb1713942": {
      "start": 2890,
      "end": 3055,
      "txt": "이들 중 한 명은 학교 교사였고",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
