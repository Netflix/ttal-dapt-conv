        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "7fb12623-7c45-46d8-8067-51ba15038e44": {
      "start": 6108,
      "end": 6176,
      "txt": "그래, 목격자지.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": "",
      "pivotText": "Yeah, a witness.",
      "pivotStyles": []
    },
    "80a55598-fc2c-4d86-8f30-2f3eeeadd8da": {
      "start": 12943,
      "end": 13013,
      "txt": "(vo) (f) 그래, 목격자지.",
      "characterId": "bcc41bd8-dc8c-4d99-a09c-4612981edd3e",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
