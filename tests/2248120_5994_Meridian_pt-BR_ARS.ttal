        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "a0540c61-cead-4c87-b626-4538950d06b9": {
      "start": 19840,
      "end": 19888,
      "txt": "Espera um minuto.",
      "transcriptionText": " Hang on a minute.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
