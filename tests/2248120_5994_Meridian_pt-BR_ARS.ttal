    "5db4afd8-a352-47e0-97f1-ef3d06cd4e00": {
      "start": 19159,
      "end": 19238,
      "txt": "Não, só o carro.",
      "transcriptionText": "No. Just his car.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
