    },
    "18a39fd3-cce8-45ce-ac15-95c1aa367cb1": {
      "start": 11910,
      "end": 11958,
      "txt": "E agora...",
      "transcriptionText": " So now...",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
