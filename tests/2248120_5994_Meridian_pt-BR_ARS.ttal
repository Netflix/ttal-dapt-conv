    },
    "6ecc876b-5e21-478b-b0e7-eb9ee8f171c1": {
      "start": 5174,
      "end": 5211,
      "txt": "Suicídio?",
      "transcriptionText": "Suicide?",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
