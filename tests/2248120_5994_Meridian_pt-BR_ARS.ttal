        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "f00d8f77-6481-40dc-b9ad-27e7e25a89f4": {
      "start": 5405,
      "end": 5470,
      "txt": "Não desta vez.",
      "transcriptionText": "Nah, not this time. ",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "f1e6e498-f5ec-473a-b689-468d4f0f8b09": {
      "start": 8487,
      "end": 9127,
      "txt": "E ele pensou na hora: como ele subiu lá?  Ele teria que ser um tremendo alpinista. O mais importante é que o cara tinha um atitude estranha. Ele vasculhou a pedra inteira como se procurasse alguma coisa ou alguém.",
      "transcriptionText": "And he's thinking to himself, \"How the hell do you get up there? You got to be a goddamn mountain climber.\" But more importantly, he says the guy's acting really funny. He's looking all over that rock, like he's looking for something or someone.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
