    "0c214b74-12be-411d-bdea-fa54509627d4": {
      "start": 20488,
      "end": 20541,
      "txt": "Capitão Foster!",
      "transcriptionText": "Captain Foster?",
      "characterId": "cfb935d6-3a44-45f2-8f22-91396c80397a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
