    },
    "1de5d17d-30df-4d91-ae8e-9168f3dc621d": {
      "start": 6024,
      "end": 6062,
      "txt": "A testemunha?",
      "transcriptionText": "A witness?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
