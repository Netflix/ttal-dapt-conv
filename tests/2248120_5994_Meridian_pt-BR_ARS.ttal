      "start": 20622,
      "end": 20724,
      "txt": "Capitão, por favor, responda.",
      "transcriptionText": "Captain, please come in!",
      "characterId": "cfb935d6-3a44-45f2-8f22-91396c80397a",
      "segments": [],
      "aux": {},
