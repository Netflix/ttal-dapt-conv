    },
    "46376fa8-30ca-4bc3-bd24-b51406e009fe": {
      "start": 33629,
      "end": 33714,
      "txt": "Ah, meu Deus.",
      "transcriptionText": "Oh my God.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
