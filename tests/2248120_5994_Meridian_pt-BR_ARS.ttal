    "99482515-4f19-44df-9c0c-3767728372a5": {
      "start": 6184,
      "end": 6266,
      "txt": "E porque você não disse logo?",
      "transcriptionText": "Well, why didn't you say that in the first place?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
