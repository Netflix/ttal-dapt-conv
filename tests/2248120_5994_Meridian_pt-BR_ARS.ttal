    "58580620-dd3d-46f5-a3b0-0958190c4c59": {
      "start": 8214,
      "end": 8445,
      "txt": "Enfim, ele olhou lá pra baixo e viu um cara no alto daquela pedra.",
      "transcriptionText": "Anyway, he looks down there and there's a guy who's on top of that rock.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
