      "start": 4168,
      "end": 4262,
      "txt": "Todos eram divorciados.",
      "transcriptionText": " They were all divorced. ",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
