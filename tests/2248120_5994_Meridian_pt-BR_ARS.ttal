      },
      "rubies": {},
      "type": ""
    },
    "394edf82-d7b1-45f7-a229-21e56d3c8343": {
      "start": 9207,
      "end": 9928,
      "txt": "E nesse exato momento, ele disse que ficou muito, muito escuro, muito rápido e bombas começaram a explodir no ar, raios e trovões, uma tempestade que ele nunca tinha visto. Vinda, não se sabe de onde...",
      "transcriptionText": "At that very moment, he says it got really, really dark really fast and bombs start going off in the air. Thunder and lightning, weather like he'd never seen before, coming from he didn't know where.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "3e4cb38f-0b25-433c-ba1c-f35e40ef4855": {
      "start": 6110,
      "end": 6178,
      "txt": "Sim, uma testemunha.",
      "transcriptionText": "Yeah, a witness.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
