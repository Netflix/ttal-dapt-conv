    },
    "9854aeb2-1ffa-4fd0-b197-3de7901d3b97": {
      "start": 2307,
      "end": 2327,
      "txt": "Sei...",
      "transcriptionText": "Yeah.",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
