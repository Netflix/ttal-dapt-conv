    },
    "818f3475-b36d-4998-8388-19457b5e286c": {
      "start": 13068,
      "end": 13798,
      "txt": "Ele disse que estava passeando com o cachorro nos penhascos a cima do El Matador, sabe? E ele viu uma cara no alto daquela pedra. Ele vasculhou a pedra inteira como se procurasse alguma coisa ou alguém...",
      "transcriptionText": "He said that he was up there walking his dog along those bluffs above El Matador. And there's a guy who's on top of that rock. And he's just like looking all over the rock as if he's looking for someone or something.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "892a46dc-ab8c-4545-bbdf-e897d5ca2c84": {
      "start": 4354,
      "end": 4501,
      "txt": "Bom, nesse caso, talvez você não queira ir até lá, chefe...",
      "transcriptionText": "Oh. Well, in that case, maybe you don't want to go out there boss.",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
