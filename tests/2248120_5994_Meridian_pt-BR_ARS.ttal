    "81508bc6-9cf3-4095-bfc1-32ec74cf60f5": {
      "start": 20107,
      "end": 20260,
      "txt": "Capitão Foster, responda, por favor...",
      "transcriptionText": "Captain Foster, come in please.",
      "characterId": "cfb935d6-3a44-45f2-8f22-91396c80397a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
