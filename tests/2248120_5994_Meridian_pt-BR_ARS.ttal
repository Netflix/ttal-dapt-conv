      "end": 31857,
      "txt": "Polícia de Los Angeles, mãos ao alto.",
      "transcriptionText": "LAPD, put your hands in the air!",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
