      "start": 2187,
      "end": 2239,
      "txt": "Com a pedra grande?",
      "transcriptionText": "With the big rock?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
