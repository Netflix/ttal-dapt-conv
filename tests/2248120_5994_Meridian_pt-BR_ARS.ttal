      "type": ""
    },
    "698be35b-afc6-4e10-b6c0-2780880ea290": {
      "start": 3510,
      "end": 4074,
      "txt": "Bom, eu chequei todos eles... Sem antecedentes criminais, sem ligação com qualquer organização criminosa. Um desses caras foi preso por dirigir bêbado, já faz muito tempo.",
      "transcriptionText": "Mm-mm. I mean, I checked them all out. There's no criminal records. No association with any criminal organizations. One of the guys was arrested for drunk driving a long time ago.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF_ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "6d98705f-8d85-40bf-a0af-3d96e6102fc3": {
      "start": 9988,
      "end": 10683,
      "txt": "Quando ele olhou de novo pra pedra, o cara sumiu, mas tinha uma mulher lá. Ela usava um vestido branco com pele de alabastro, palavras dele. E ele disse que ela estava olhando na direção dele.",
      "transcriptionText": "When he looks back at the rock, the guy's gone. But there's a woman there. She's in a white dress. Alabaster skin, his words, and he says she's staring right up at him.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
