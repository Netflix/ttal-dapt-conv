    },
    "9f8ac91f-6e86-41d3-9bf0-2e923aef44c2": {
      "start": 2719,
      "end": 3252,
      "txt": "Máfia? Não, não desta vez. Um desses caras era só um professor. O outro vendia seguros. E o último era aposentado.",
      "transcriptionText": "Mob hits? Nah, not this time. One of these guys was a schoolteacher. Next guy, he sold insurance. Last guy, he was retired.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Mob hits: people killed by the mob/mafia."
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON_OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
