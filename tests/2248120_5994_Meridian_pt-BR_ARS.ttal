    "45b24319-4d51-4b99-b60c-990dc2bc780e": {
      "start": 1860,
      "end": 2035,
      "txt": "É, perto daquele trecho da estrada do El Matador.",
      "transcriptionText": " Yeah, on that stretch of road right above El Matador. You know it?",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
