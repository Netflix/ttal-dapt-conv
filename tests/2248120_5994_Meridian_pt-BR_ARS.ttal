    "4ee3b938-a0c7-41f3-898d-3a3310e67a5e": {
      "start": 18688,
      "end": 19070,
      "txt": "Alô, central, aqui é o capitão Foster. Eu estou aqui na estrada do El Matador. Não há sinal do detetive Sullivan.",
      "transcriptionText": "Yeah, dispatch, this is Captain Foster. I'm out here at the El Matador location. There's no sign of Detective Sullivan.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
