    },
    "7cf34647-2a1d-4e44-92a9-2d7dddabf5c9": {
      "start": 12878,
      "end": 12922,
      "txt": "Uma testemunha?",
      "transcriptionText": "A witness?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
