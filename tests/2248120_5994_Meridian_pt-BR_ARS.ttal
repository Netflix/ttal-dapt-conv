    "5eb10d27-2a94-436c-8c43-600ba398d0c4": {
      "start": 4834,
      "end": 5157,
      "txt": "Olha, eu sei o que aconteceu, tá bom? Eles vão até a pedra e dão aquele mergulho lento e frio até a china.",
      "transcriptionText": "Yeah, look, I know what happened, alright. They go out to the rock. They take that long, cold, slow swim to China.",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
