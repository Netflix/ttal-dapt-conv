    "1705ad43-6178-49c3-8c42-e976c5c297b9": {
      "start": 2436,
      "end": 2680,
      "txt": "Mickey Cohen costumava levar os sócios pra lá. Dar um bon voyage.",
      "transcriptionText": "Well, Mickey Cohen used to take his associates out there. Bid them a bon voyage. ",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.ForeignDialog"
        ],
        "text": "bon voyage - French way to say goodbye "
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
