    "47f3bb42-2ce4-444f-b319-313e719fff51": {
      "start": 19316,
      "end": 19472,
      "txt": "Olha, eu vou dar uma olhada antes de mandarem alguém pra cá, então...",
      "transcriptionText": "Listen, I'm going to take a look around before you send anybody out here. So--",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "48c9b289-e200-44d4-b5d8-20487d3e636c": {
      "start": 2260,
      "end": 2295,
      "txt": "Isso mesmo.",
      "transcriptionText": "That's right.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
