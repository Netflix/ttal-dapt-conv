    "7ae518cc-8986-4ea9-bec4-2353c4939985": {
      "start": 1614,
      "end": 1768,
      "txt": "Então esses caras simplesmente sumiram?",
      "transcriptionText": "So these guys just... disappear?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
