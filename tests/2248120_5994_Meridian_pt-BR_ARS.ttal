    "a83c050f-baae-44b4-bfef-6c7877acb66c": {
      "start": 2100,
      "end": 2124,
      "txt": "Conhece?",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "aa335101-ea9f-4be3-9a4f-9182148c87f9": {
      "start": 12016,
      "end": 12272,
      "txt": "Agora preciso que você vá até lá e encontre essa mulher.",
      "transcriptionText": "Now, I need you to go up there and find that woman.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "bc0ade06-73fe-4cd5-8e5d-cd7cd16d02e2": {
      "start": 31954,
      "end": 32032,
      "txt": "Mãos pra cima agora!",
      "transcriptionText": "Put your hands up now.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "c28ffeb8-42b0-4a82-a37f-74f189cf5296": {
      "start": 13967,
      "end": 15556,
      "txt": "E então ficou muito escuro de repente, muito rápido... Raios e trovões por toda parte, uma tempestade. Quando ele olhou de novo para a pedra o cara sumiu mas tinha uma mulher lá. Ela usava um vestido branco e tinha uma pele de alabastro, e ela estava olhando na direção dele sem se mover. Agora eu não sei no que acreditar. Mas sei que não quero acreditar nele.",
      "transcriptionText": "Then, it gets dark all of a sudden. Really fast. Like thunder and lightning from everywhere, all this weather. When he looks back at the rock... the guys gone, but there's a woman there in a long white dress with Alabaster skin. And she staring right up at him, not moving. I don't know what to believe. I know I sure don't want to believe him.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "cd770c14-9d41-4ec7-92d9-05b80fc4406b": {
      "start": 5255,
      "end": 5327,
      "txt": "Costuma acontecer lá.",
      "transcriptionText": "It's been known to happen out there.",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "cf859d94-6aaa-4794-8274-2c020f6703ad": {
      "start": 5493,
      "end": 5520,
      "txt": "Como assim?",
      "transcriptionText": "What do you mean?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "e4ab58e0-dcd7-4908-8e65-6ec10dfcbcfc": {
      "start": 6534,
      "end": 6601,
      "txt": "Mas agora acredita?",
      "transcriptionText": "And now you believe him?",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "e5b93cdc-dd17-444a-a9c7-372c49e36d2e": {
      "start": 8163,
      "end": 8181,
      "txt": "Sei.",
      "transcriptionText": "Yeah.",
      "characterId": "ff669043-0afa-4f1f-a750-d4d860556837",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "ee75f0f9-520d-46b5-9a72-f15f8171cf38": {
      "start": 12626,
      "end": 12884,
      "txt": "Não, não desta vez. Alguém estava lá no dia em que o último homem desapareceu?",
      "transcriptionText": "Nah, not this time. Somebody was out there the day the last guy disappeared.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "OFF",
      "tag": {
        "on": false,
