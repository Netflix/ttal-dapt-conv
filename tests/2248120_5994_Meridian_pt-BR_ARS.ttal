      "type": ""
    },
    "9c062618-8f1e-49fb-89d0-63bb714f956a": {
      "start": 6308,
      "end": 6480,
      "txt": "Porque achei que o cara era louco pelo que ele disse.",
      "transcriptionText": "Because I thought the guy was nuts. What he said...",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [
          "Annotation.Context"
        ],
        "text": "Nuts: crazy."
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
        "on": false,
        "color": "#CCCCCC",
        "text": ""
      },
      "voice": {
        "spans": [],
        "tags": {}
      },
      "rubies": {},
      "type": ""
    },
    "9d922433-6fca-40dd-a5fe-221f1d1aff11": {
      "start": 5786,
      "end": 5968,
      "txt": "Alguém estava lá no dia em que o último homem desapareceu.",
      "transcriptionText": "Somebody was out there the day the last guy disappeared.",
      "characterId": "e1312a3b-38da-4fe8-a7e3-ca4068782b5a",
      "segments": [],
      "aux": {},
      "dubAnnotations": {
        "types": [],
        "text": ""
      },
      "styles": [],
      "transcriptionStyles": [],
      "transcriptionRubies": {},
      "onScreen": "ON",
      "tag": {
